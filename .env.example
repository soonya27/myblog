# 이 파일은 깃에 커밋되는 예시 파일입니다.
# 실제 값은 .env.local 에 채우세요. (.env.local 은 .gitignore 에 포함)

# ────────────────────────────────────────
# Contact 폼 (Nodemailer / Gmail SMTP)
# ────────────────────────────────────────
AUTH_USER=
AUTH_PASS=

# ────────────────────────────────────────
# Supabase
# Project Settings → API 메뉴에서 복사
# ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ service_role 키는 DB 전체 권한입니다. 절대 클라이언트 코드에 사용 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ────────────────────────────────────────
# 어드민 화이트리스트
# OAuth(Google 등) 콜백에서 user.email 이 이 값과 다르면 즉시 signOut.
# 본인 계정 1개만 어드민으로 통과시키기 위함.
# ────────────────────────────────────────
ADMIN_EMAIL=
